local TP = 3
local RADIUS = 3
local SPEED = 8
local ORBIT_TIME = 1.2
local QUICK_TIME = 0.35
local QUICK_RAD = 2

local KEEP_X = 0.50
local KEEP_Y = 0.13
local KEY = 0x59

local STUCK_THRESHOLD = 3
local STUCK_TIME = 5

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local Camera = Workspace.CurrentCamera
local LP = Players.LocalPlayer

local running = false
local deliveries = 0
local startTime = tick()
local startMoney = nil
local lastMoney = nil
local earned = 0
local hrpCache = nil
local hrpChar = nil

local OFFSETS = {{0,0},{-3,0},{3,0},{0,-3},{0,3}}

local function find(p, n, t)
    t = t or 10
    local c = p:FindFirstChild(n)
    if c then return c end
    local s = tick()
    while tick() - s < t do
        wait(0.1)
        c = p:FindFirstChild(n)
        if c then return c end
    end
end

local function hrp()
    local char = LP.Character
    if char == hrpChar and hrpCache then return hrpCache end
    while not char do wait(0.1); char = LP.Character end
    local h = find(char, "HumanoidRootPart")
    hrpChar, hrpCache = char, h
    return h
end

local function teleport(pos, h)
    h.CFrame = CFrame.new(pos.X, pos.Y + TP, pos.Z)
end

local function spin(part, radius, duration, h)
    local px, py, pz = part.Position.X, part.Position.Y + TP, part.Position.Z
    local t0 = tick()
    local mt, st = math.cos, math.sin
    while true do
        local e = tick() - t0
        if e >= duration then break end
        local a = e * SPEED
        h.CFrame = CFrame.new(px + mt(a) * radius, py, pz + st(a) * radius)
        wait()
    end
    h.CFrame = CFrame.new(px, py, pz)
end

local function jobPart()
    local j = Workspace:FindFirstChild("Jobs")
    j = j and j:FindFirstChild("Pizza")
    j = j and j:FindFirstChild("Parts")
    return j and j:FindFirstChild("JobPart")
end

local function activeDrop()
    local j = Workspace:FindFirstChild("Jobs")
    j = j and j:FindFirstChild("Pizza")
    j = j and j:FindFirstChild("Locations")
    if not j then return end
    for _, c in ipairs(j:GetChildren()) do
        if c.Name == "DropLocation" then
            for _, d in ipairs(c:GetChildren()) do
                if d:IsA("PointLight") then return c end
            end
        end
    end
end

local function jobDoneVisible()
    local pg = LP:FindFirstChild("PlayerGui")
    local jg = pg and pg:FindFirstChild("JobGui")
    local jd = jg and jg:FindFirstChild("JobDone")
    if not jd then return false end
    local ok, v = pcall(function() return jd.Visible end)
    if ok and v ~= nil then return v end
    return true
end

local function clickAt(px, py)
    mousemoveabs(px, py)
    mouse1click()
end

local function clickKeep()
    local vp = Camera.ViewportSize
    local cx = math.floor(vp.X * KEEP_X)
    local cy = math.floor(vp.Y * KEEP_Y)
    for i = 1, 5 do
        local o = OFFSETS[i]
        clickAt(cx + o[1], cy + o[2])
    end
end

local function handleKeepGoing()
    local t0 = tick()
    while tick() - t0 < 2 do
        if jobDoneVisible() then break end
        wait(0.05)
    end
    for _ = 1, 4 do
        clickKeep()
        wait(0.25)
        if not jobDoneVisible() then return end
    end
end

local function getMoney()
    local ls = LP:FindFirstChild("leaderstats")
    local m = ls and ls:FindFirstChild("Money")
    return m and m.Value or nil
end

local hud = Drawing.new("Text")
hud.Size = 18
hud.Outline = true
hud.Center = false
hud.Position = Vector2.new(20, 60)
hud.Visible = true

local function updateHud()
    local elapsed = tick() - startTime
    local mins = elapsed / 60
    local hours = mins / 60
    local money = getMoney() or (startMoney or 0) + earned
    local total = startMoney and (money - startMoney) or earned
    local perMin = mins > 0 and total / mins or 0
    local perHr = hours > 0 and total / hours or 0
    local avg = deliveries > 0 and total / deliveries or 0

    hud.Color = running and Color3.fromRGB(0, 255, 120) or Color3.fromRGB(255, 80, 80)

    hud.Text = string.format(
        "[%s]  Y to toggle\nDeliveries: %d\nMoney: $%d\nEarned: $%d\nAvg: $%d\n$/min: $%d\n$/hr: $%d",
        running and "ON" or "OFF",
        deliveries, math.floor(money), math.floor(total),
        math.floor(avg), math.floor(perMin), math.floor(perHr)
    )
end

local function resetSession()
    startTime = tick()
    startMoney = getMoney() or startMoney
    lastMoney = startMoney
    earned = 0
    deliveries = 0
end

startMoney = getMoney() or 0
lastMoney = startMoney

task.spawn(function()
    while true do
        local m = getMoney()
        if m and lastMoney then
            local d = m - lastMoney
            if d > 0 then earned = earned + d end
            lastMoney = m
        end
        updateHud()
        wait(0.25)
    end
end)

task.spawn(function()
    local prev = false
    while true do
        local down = iskeypressed(KEY)
        if down and not prev then
            running = not running
            if running then resetSession() end
        end
        prev = down
        wait(0.05)
    end
end)

task.spawn(function()
    local lastPos = nil
    local stillSince = tick()

    while true do
        if running then
            local h = hrp()

            if h then
                local p = h.Position
                if lastPos then
                    local moved = (p - lastPos).Magnitude
                    if moved < STUCK_THRESHOLD then
                        if tick() - stillSince > STUCK_TIME then
                            local red = jobPart()
                            if red then
                                teleport(red.Position, h)
                            end
                            stillSince = tick()
                        end
                    else
                        stillSince = tick()
                    end
                end
                lastPos = p
            end

            local red = jobPart()
            if red and h then
                teleport(red.Position, h)
                spin(red, QUICK_RAD, QUICK_TIME, h)
            end

            local green = activeDrop()
            if green and h then
                teleport(green.Position, h)
                wait(0.15)
                spin(green, RADIUS, ORBIT_TIME, h)
                deliveries = deliveries + 1
            end

            handleKeepGoing()
            wait(0.1)
        else
            wait(0.1)
        end
    end
end)

function stop()
    running = false
    hud:Remove()
end
