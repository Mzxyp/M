local TP_OFFSET = 3
local CIRCLE_RADIUS = 3
local CIRCLE_SPEED = 8
local CIRCLE_TIME = 1.2
local QUICK_TIME = 0.35
local QUICK_RADIUS = 2

local KEEP_X = 0.50
local KEEP_Y = 0.13

local TOGGLE_KEY = 0x59

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer

local running = false
local deliveries = 0
local startTime = tick()
local startMoney = nil
local lastMoney = nil
local earnedThisSession = 0

local function find(parent, name)
    local c = parent:FindFirstChild(name)
    local t = tick()
    while not c and tick() - t < 10 do
        wait(0.1)
        c = parent:FindFirstChild(name)
    end
    return c
end

local function hrp()
    local char = LocalPlayer.Character
    while not char do wait(0.1); char = LocalPlayer.Character end
    return find(char, "HumanoidRootPart")
end

local function tp(pos)
    local h = hrp()
    if h then h.CFrame = CFrame.new(pos.X, pos.Y + TP_OFFSET, pos.Z) end
end

local function spin(part, radius, duration)
    local h = hrp()
    if not h then return end
    local c = part.Position + Vector3.new(0, TP_OFFSET, 0)
    local t0 = tick()
    while tick() - t0 < duration do
        local a = (tick() - t0) * CIRCLE_SPEED
        h.CFrame = CFrame.new(c.X + math.cos(a) * radius, c.Y, c.Z + math.sin(a) * radius)
        wait()
    end
    h.CFrame = CFrame.new(c.X, c.Y, c.Z)
end

local function jobPart()
    local p = Workspace:FindFirstChild("Jobs")
    p = p and p:FindFirstChild("Pizza")
    p = p and p:FindFirstChild("Parts")
    return p and p:FindFirstChild("JobPart")
end

local function activeDrop()
    local p = Workspace:FindFirstChild("Jobs")
    p = p and p:FindFirstChild("Pizza")
    p = p and p:FindFirstChild("Locations")
    if not p then return end
    for _, c in ipairs(p:GetChildren()) do
        if c.Name == "DropLocation" then
            for _, d in ipairs(c:GetChildren()) do
                if d:IsA("PointLight") then return c end
            end
        end
    end
end

local function clickAt(px, py)
    mousemoveabs(px, py)
    wait(0.02)
    mouse1click()
    wait(0.02)
end

local function clickKeep()
    local vp = Workspace.CurrentCamera.ViewportSize
    local cx = math.floor(vp.X * KEEP_X)
    local cy = math.floor(vp.Y * KEEP_Y)
    for _, o in ipairs({{0,0},{-3,0},{3,0},{0,-3},{0,3}}) do
        clickAt(cx + o[1], cy + o[2])
    end
end

local function getMoney()
    local ls = LocalPlayer:FindFirstChild("leaderstats")
    local m = ls and ls:FindFirstChild("Money")
    return m and m.Value or nil
end

local hud

local function buildHud()
    hud = Drawing.new("Text")
    hud.Size = 18
    hud.Color = Color3.fromRGB(0, 255, 120)
    hud.Outline = true
    hud.Center = false
    hud.Position = Vector2.new(20, 60)
    hud.Visible = true
end

local function updateHud()
    if not hud then return end
    local elapsed = tick() - startTime
    local mins = elapsed / 60
    local hours = mins / 60

    local money = getMoney() or (startMoney or 0) + earnedThisSession
    local earned = startMoney and (money - startMoney) or earnedThisSession

    local perMin = mins > 0 and earned / mins or 0
    local perHr  = hours > 0 and earned / hours or 0
    local avg = deliveries > 0 and earned / deliveries or 0

    hud.Color = running and Color3.fromRGB(0, 255, 120) or Color3.fromRGB(255, 80, 80)

    hud.Text = string.format(
        "[%s]  Y to toggle\nDeliveries: %d\nMoney: $%d\nEarned: $%d\nAvg/delivery: $%d\n$/min: $%d\n$/hr: $%d",
        running and "ON" or "OFF",
        deliveries, math.floor(money), math.floor(earned),
        math.floor(avg), math.floor(perMin), math.floor(perHr)
    )
end

startMoney = getMoney() or 0
lastMoney = startMoney

buildHud()

task.spawn(function()
    while true do
        local m = getMoney()
        if m and lastMoney then
            local delta = m - lastMoney
            if delta > 0 then earnedThisSession = earnedThisSession + delta end
            lastMoney = m
        end
        updateHud()
        wait(0.25)
    end
end)

task.spawn(function()
    local wasDown = false
    while true do
        local down = iskeypressed(TOGGLE_KEY)
        if down and not wasDown then
            running = not running
            if running then
                startTime = tick()
                startMoney = getMoney() or startMoney
                lastMoney = startMoney
                earnedThisSession = 0
                deliveries = 0
            end
        end
        wasDown = down
        wait(0.05)
    end
end)

task.spawn(function()
    while true do
        if running then
            local red = jobPart()
            if red then
                tp(red.Position)
                spin(red, QUICK_RADIUS, QUICK_TIME)
            end

            local green = activeDrop()
            if green then
                tp(green.Position)
                wait(0.15)
                spin(green, CIRCLE_RADIUS, CIRCLE_TIME)
                deliveries = deliveries + 1
            end

            wait(0.5)
            for _ = 1, 4 do clickKeep(); wait(0.25) end
            wait(0.15)
        else
            wait(0.1)
        end
    end
end)

function stop()
    running = false
    if hud then hud:Remove() end
end
